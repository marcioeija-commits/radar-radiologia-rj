# Variáveis públicas do app Expo. São incorporadas ao bundle do aplicativo.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_APP_ID=

# Variáveis privadas do backend. Nunca use o prefixo EXPO_PUBLIC_ nestas variáveis.
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=

# Opcional: openId do usuário que deve receber papel de administrador.
OWNER_OPEN_ID=
